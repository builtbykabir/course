NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/course_website
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Course Website <onboarding@resend.dev>
S3_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=course-videos
S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
S3_PRESIGNED_URL_TTL_HOURS=2
